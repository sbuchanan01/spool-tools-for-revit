<Window x:Class="SpoolTools.UI.SpoolerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Spooler"
        Width="550" Height="900"
        MinWidth="500" MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#2D6B9E"/>
            <Setter Property="Margin"     Value="0,6,0,3"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6B9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="18,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding"    Value="14,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 Selection summary badge -->
            <RowDefinition Height="Auto"/>   <!-- 1 Numbering section header -->
            <RowDefinition Height="Auto"/>   <!-- 2 Numbering grid -->
            <RowDefinition Height="Auto"/>   <!-- 3 Selection section header -->
            <RowDefinition Height="Auto"/>   <!-- 4 Selection grid -->
            <RowDefinition Height="Auto"/>   <!-- 5 Rules section header -->
            <RowDefinition Height="Auto"/>   <!-- 6 Rules grid -->
            <RowDefinition Height="Auto"/>   <!-- 7 Renumber checkbox row -->
            <RowDefinition Height="Auto"/>   <!-- 8 Renumber options grid (collapses when off) -->
            <RowDefinition Height="Auto"/>   <!-- 9 Preview section header -->
            <RowDefinition Height="*"/>      <!-- 10 Preview area -->
            <RowDefinition Height="Auto"/>   <!-- 11 Footer -->
        </Grid.RowDefinitions>

        <!-- ═══ SELECTION POOL — the walk stays inside this set ═══ -->
        <Border Grid.Row="0" Background="#E8EEF4" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="{Binding SelectionSummary}"
                           Foreground="{Binding SelectionSummaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Reset" Style="{StaticResource SecondaryButton}"
                            Click="ResetSelection_Click" Margin="0,0,6,0"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="Clears the pool. Start and Break picks that referenced parts in the pool are also cleared."/>
                    <Button Content="Pick More…" Style="{StaticResource SecondaryButton}"
                            Click="PickMore_Click"
                            ToolTip="Hides this dialog, lets you pick more fabrication parts in Revit. Click Finish on the ribbon when done."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ NUMBERING & NAMING ═══ -->
        <!-- Per-batch fields stay here (Identifier / Starting sequence /
             Starting sheet # almost always change per batch). The two
             format templates are read-only — they're project defaults
             that rarely change, so the editable copy lives in Spool
             Config and we show the current value here with an
             "Edit in Spool Config" shortcut. Keeps the dialog focused on
             the per-batch decision surface. -->
        <TextBlock Grid.Row="1" Style="{StaticResource SectionHeader}" Text="Spool Numbering &amp; Naming"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="* Identifier:"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                       Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Free-text identifier substituted for the {ID} property (e.g., '001' or 'BldgA-L3'). Same value used for every spool in this batch."/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Format:"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Foreground="#444444"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Spool number and name formats. Edit in Spool Config — this is the project default shared with Create Spool.">
                    <Run Text="{Binding SpoolNumberTemplate, Mode=OneWay}"/>
                    <Run Text="  ·  " Foreground="#999999"/>
                    <Run Text="{Binding SpoolNameTemplate, Mode=OneWay}"/>
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Click="SpoolConfig_Click"
                        Content="Edit" Padding="14,4"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Open Spool Config to change these formats. Saved values refresh here immediately."/>
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="* Starting sequence:"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                       Text="{Binding StartingSequenceText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="First number used for the {N} property. Increments by 1 per spool."/>

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="* Starting sheet #:"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                       Text="{Binding StartingSheetNumber, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="First sheet number assigned. Trailing digits increment per spool (e.g., S1 → S1, S2, S3…). Existing sheet numbers are skipped automatically."/>
        </Grid>

        <!-- ═══ SELECTION ═══ -->
        <TextBlock Grid.Row="3" Style="{StaticResource SectionHeader}" Text="Selection"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="* Start element:"/>
            <Button    Grid.Row="0" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                       Click="PickStart_Click" Content="Pick start…" Margin="0,2,8,4"
                       ToolTip="Single click on the first part of the run. Walk begins here."/>
            <TextBlock Grid.Row="0" Grid.Column="2"
                       VerticalAlignment="Center" Margin="0,0,0,4"
                       FontSize="11"
                       Text="{Binding StartStatus}"
                       Foreground="{Binding StartStatusBrush}"/>

            <!-- Service line — high-visibility callout so the user can
                 walk away and come back without losing their context.
                 Shows the start element's Fabrication Service abbreviation
                 the moment Pick start succeeds. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Service:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       VerticalAlignment="Center" Margin="0,2,0,6"
                       FontSize="14" FontWeight="SemiBold"
                       Text="{Binding ServiceDisplay}"
                       Foreground="{Binding ServiceDisplayBrush}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Break elements:"/>
            <Button    Grid.Row="2" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                       Click="PickBreaks_Click" Content="Pick breaks…" Margin="0,2,8,4"
                       ToolTip="Multi-pick. Each picked part is the LAST part of its spool — the next walked part starts a new spool. Click Finish on the ribbon when done. Pick nothing for a single spool covering the entire walk."/>
            <TextBlock Grid.Row="2" Grid.Column="2"
                       VerticalAlignment="Center" Margin="0,0,0,4"
                       FontSize="11"
                       Text="{Binding BreaksStatus}"
                       Foreground="{Binding BreaksStatusBrush}"/>
        </Grid>

        <!-- ═══ AUTO-SPLIT RULES ═══ -->
        <TextBlock Grid.Row="5" Style="{StaticResource SectionHeader}" Text="Auto-Split Rules"/>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                      Content="At Field Welds"
                      Margin="0,2,0,4"
                      IsChecked="{Binding RuleAtFieldWelds}"
                      ToolTip="Add a break at every part with CID 2522, Product Range containing &quot;Joint&quot;, and Name (or Item Description or Comments) containing &quot;Field Weld&quot;. Each field-installed weld becomes its own spool boundary."/>

            <CheckBox Grid.Row="1" Grid.Column="0"
                      Content="Max Weight:" VerticalAlignment="Center"
                      Margin="0,2,0,4"
                      IsChecked="{Binding RuleMaxWeightEnabled}"
                      ToolTip="When adding a part would push a spool's cumulative weight over this value, the previous part becomes a break — the heavy part starts a new spool."/>
            <TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,2,0,4"
                     IsEnabled="{Binding RuleMaxWeightEnabled}"
                     Text="{Binding RuleMaxWeightLbText, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"
                       VerticalAlignment="Center" Foreground="#777777"
                       Text="lbs (per spool)"/>

            <CheckBox Grid.Row="2" Grid.Column="0"
                      Content="Max Length:" VerticalAlignment="Center"
                      Margin="0,2,0,4"
                      IsChecked="{Binding RuleMaxLengthEnabled}"
                      ToolTip="When the cumulative bounding-box length within a spool would exceed this value, the previous part becomes a break. Accepts &quot;10.5&quot; (decimal feet), &quot;10-6&quot; or &quot;10'-6\&quot;&quot; (feet-inches)."/>
            <TextBox Grid.Row="2" Grid.Column="1" Width="80" Margin="0,2,0,4"
                     IsEnabled="{Binding RuleMaxLengthEnabled}"
                     Text="{Binding RuleMaxLengthText, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="6,0,0,0"
                       VerticalAlignment="Center" Foreground="#777777"
                       Text="ft  (e.g. 10.5 or 10-6)"/>

            <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                      Content="Convert Spool Joining Welds to Field Welds"
                      Margin="0,8,0,4"
                      IsChecked="{Binding ConvertSplitWeldsToFieldWelds}"
                      ToolTip="A weld that would otherwise be the sole part of a spool drawing is always folded into the next spool in walk order — no lone-weld sheets get created. With this option ON, every weld that joins two spools (isolated/folded welds AND welds whose neighbours sit in different spool partitions) is REPLACED with the Field Weld catalog item from the same fabrication service at the same bore: the original part is deleted, a new Field Weld part is created, sized, moved to the same location, and reconnected to the same two neighbours. Warnings explain any swap failures (e.g. service has no Field Weld button). With it OFF, the merge still happens but the welds' original catalog item is preserved."/>
        </Grid>

        <!-- ═══ RENUMBER ═══ -->
        <CheckBox Grid.Row="7" Content="Renumber 'Item Number' on these parts before spooling"
                  IsChecked="{Binding RenumberEnabled}"
                  Margin="0,4,0,4"
                  ToolTip="When on, writes sequential values to the 'Item Number' parameter on the parts of each spool using the starting number below. Renumber runs per spool — the starting number resets for each partition."/>
        <Grid Grid.Row="8" IsEnabled="{Binding RenumberEnabled}" Margin="20,0,0,4"
              Visibility="{Binding RenumberVisible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="* Starting Number:"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                       Text="{Binding RenumberStartingNumberText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="The first part of each spool gets this number; subsequent parts get +1 each (unless using the identical-parts rule below). Resets per spool."/>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                <CheckBox Content="Use same number for identical parts"
                          IsChecked="{Binding RenumberUseSameForIdentical}"
                          ToolTip="When on, parts with the same CID + size + Item Description + Item Code collapse to share one number within the same spool. When off, every part gets its own sequential number."/>
                <CheckBox Content="Include Welds" Margin="20,0,0,0"
                          IsChecked="{Binding IncludeWelds}"
                          ToolTip="When on (default), every walked part is renumbered and tagged. When off, parts whose Product Range is &quot;Joints&quot; (welds, joint fittings) are skipped for Item Number renumbering AND tag placement — they're still pinned and shown in the views."/>
            </StackPanel>

            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Use length as a separator"
                      Margin="0,2,0,0"
                      IsEnabled="{Binding RenumberUseSameForIdentical}"
                      IsChecked="{Binding RenumberUseLengthAsSeparator}"
                      ToolTip="Only meaningful when 'Use same number for identical parts' is on. Pipes of different centerline lengths get different numbers (rounded to 1/16&quot;); non-pipe parts ignore length."/>
        </Grid>

        <!-- ═══ PREVIEW ═══ -->
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="Preview"/>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Click="RefreshPreview_Click" Content="Refresh"
                    Margin="0,4,0,2" Padding="10,2"
                    ToolTip="Force the preview to repaint with the current Start, Breaks, and Auto-Split Rules. Use if the colors didn't update automatically."/>
        </Grid>
        <Border Grid.Row="10" BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 3D viewport. PreviewControl gets injected as the
                     Border's Child by AttachPreviewIfReady on Loaded.
                     Until then a placeholder explains what the user
                     will see once Start is picked. -->
                <Border Grid.Row="0" x:Name="PreviewHost" Background="#1F1F1F">
                    <TextBlock Text="Pick the Start element to color-code the run by partition."
                               Foreground="#AAAAAA" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
                </Border>

                <!-- Text preview underneath shows the first three resolved
                     spool numbers + sheet numbers so the user can sanity-
                     check the templates before committing. Uses the
                     inherited Segoe UI font (Revit's standard) rather
                     than a forced monospace — the values themselves are
                     short enough that proportional reads cleanly. -->
                <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                        Background="White" Padding="10,6">
                    <TextBlock Text="{Binding PreviewText}" FontSize="11"
                               Foreground="#444444" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="11" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,4,0,0">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock FontSize="11" Foreground="#888888"
                               Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="11" Foreground="#666666" FontStyle="Italic"
                               TextWrapping="Wrap"
                               Text="* Make sure all required settings applied."/>
                    <TextBlock FontSize="10" Foreground="#999999" TextWrapping="Wrap"
                               Text="*Required setting"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Spool Config…" Style="{StaticResource SecondaryButton}"
                                Click="SpoolConfig_Click" Margin="0,0,12,0"
                                ToolTip="Open the shared Spool Config dialog to edit project-level defaults (titleblock, schedule, default scale, view directions, view template, tag family, leader defaults, batch templates). Changes take effect the next time you open this dialog."/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Click="Cancel_Click" IsCancel="True" Margin="0,0,6,0"/>
                        <Button Content="Create Spools" Style="{StaticResource PrimaryButton}"
                                Click="Create_Click" IsDefault="True"
                                IsEnabled="{Binding CanCreate}"/>
                    </StackPanel>
                    <CheckBox Content="Use Assemblies"
                              HorizontalAlignment="Right" Margin="0,6,0,0"
                              IsChecked="{Binding UseAssemblies}"
                              ToolTip="When on, each spool becomes a Revit AssemblyInstance (members + assembly views + assembly sheet) instead of an ad-hoc 3D view tree on a normal sheet. All other settings (titleblock, drawable region, schedule, scale, tag, leader, renumber, view template, Include Welds) apply identically. Parts already in another assembly will cause the batch to abort with the conflict list."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
